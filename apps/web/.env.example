# M. DADU FILMS - FRONTEND ENVIRONMENT TEMPLATE
# Copy this file to either:
#   apps/web/.env.dev
#   apps/web/.env.prod

NEXT_PUBLIC_API_URL=http://localhost:8888/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3333

# GOOGLE IDENTITY SERVICES
# Use the same OAuth 2.0 Web Client ID as apps/api GOOGLE_CLIENT_ID.
# No Google client secret is used by the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Production reminders for .env.prod:
# NEXT_PUBLIC_API_URL=https://api.mdadufilms.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://mdadufilms.com
