{
  "name": "@mdadu/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env.prod dist/main.js",
    "start:dev": "node --env-file=.env.dev --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "db:indexes": "npm run db:indexes:dev",
    "prestart:dev": "node ../../scripts/check-env-files.mjs dev api",
    "prestart": "node ../../scripts/check-env-files.mjs prod api",
    "prestart:prod": "node ../../scripts/check-env-files.mjs prod api",
    "start:prod": "node --env-file=.env.prod dist/main.js",
    "db:indexes:dev": "node --env-file=.env.dev -r ts-node/register src/scripts/create-indexes.ts",
    "db:indexes:prod": "node --env-file=.env.prod -r ts-node/register src/scripts/create-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "mongoose": "9.10.1",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
