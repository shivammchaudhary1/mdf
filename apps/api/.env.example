# =========================================================
# M. DADU FILMS - BACKEND ENVIRONMENT TEMPLATE
# Copy this file to either:
#   apps/api/.env.dev
#   apps/api/.env.prod
# Then set values for that environment.
# =========================================================

# APPLICATION
NODE_ENV=development
PORT=8888
FRONTEND_URL=http://localhost:3333

# MONGODB
MONGODB_URI=mongodb://127.0.0.1:27017/mdf-dev
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_MS=60000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_AUTO_INDEX=true

# AUTH / SESSION
COOKIE_SECRET=replace_with_random_secret_at_least_32_characters
COOKIE_DOMAIN=
SESSION_SHORT_HOURS=12
SESSION_REMEMBER_DAYS=30
SESSION_MAX_PER_USER=10

# RATE LIMIT
GENERAL_RATE_LIMIT_PER_MINUTE=300

# GOOGLE AUTH\n# OAuth 2.0 Web Client ID from Google Cloud Console.\n# Use the same value in apps/web NEXT_PUBLIC_GOOGLE_CLIENT_ID.\n# This backend verifies Google ID tokens; a client secret is not required for this browser credential flow.\nGOOGLE_CLIENT_ID=\n
# STORAGE
STORAGE_DRIVER=local
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=

# INFRA / SECURITY
TRUST_PROXY=false
AUDIT_RETENTION_DAYS=180

# API DOCS
SWAGGER_ENABLED=true

# ---------------------------------------------------------
# Production reminders for .env.prod:
# NODE_ENV=production
# FRONTEND_URL=https://mdadufilms.com
# MONGODB_URI=<production Atlas URI>
# MONGODB_AUTO_INDEX=false
# COOKIE_DOMAIN=.mdadufilms.com
# STORAGE_DRIVER=s3
# AWS_REGION=ap-south-1
# S3_BUCKET=mdadu-films-media
# TRUST_PROXY=true
# SWAGGER_ENABLED=false
# ---------------------------------------------------------
