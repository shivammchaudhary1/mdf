NODE_ENV=development
PORT=8888

# Local Docker Mongo:
MONGODB_URI=mongodb://localhost:27017/mdadu_films

# Frontend origin(s), comma separated if more than one:
FRONTEND_URL=http://localhost:3333

# Reserved for Stage 4 authentication:
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
COOKIE_SECRET=replace_with_a_long_random_secret

# Optional real mail delivery. Leave SMTP_HOST empty for the private local outbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=
