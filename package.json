{
  "name": "mdadu-films-platform",
  "version": "1.0.0",
  "private": true,
  "description": "M. Dadu Films Digital Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.11.1"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"npm run dev -w @mdadu/web\" \"npm run start:dev -w @mdadu/api\"",
    "dev:web": "npm run dev -w @mdadu/web",
    "dev:api": "npm run start:dev -w @mdadu/api",
    "build": "npm run build -w @mdadu/web && npm run build -w @mdadu/api",
    "start:prod": "concurrently -n WEB,API -c cyan,magenta \"npm run start -w @mdadu/web\" \"npm run start -w @mdadu/api\"",
    "lint": "eslint apps --ext .ts,.tsx",
    "lint:fix": "eslint apps --ext .ts,.tsx --fix",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"*.json\" \"*.mjs\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"*.json\" \"*.mjs\"",
    "typecheck": "npm run typecheck -w @mdadu/web && npm run typecheck -w @mdadu/api",
    "test": "npm run test -w @mdadu/api",
    "test:integration": "npm run build -w @mdadu/api && node scripts/integration-test.mjs",
    "audit:repo": "node scripts/pre-uat-repo-audit.mjs",
    "check": "npm run audit:repo && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify": "npm run check && npm run test:integration",
    "verify:local": "npm run db:up && npm run verify",
    "env:check:dev": "node scripts/check-env-files.mjs dev all",
    "env:check:prod": "node scripts/check-env-files.mjs prod all",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "db:local": "docker compose -p mdadu-local -f docker-compose.local.yml up -d",
    "db:indexes:dev": "npm run db:indexes:dev -w @mdadu/api",
    "db:indexes:prod": "npm run db:indexes:prod -w @mdadu/api"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.70.0"
  }
}
