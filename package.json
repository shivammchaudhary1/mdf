{
  "name": "mdadu-films-platform",
  "version": "1.0.0",
  "private": true,
  "description": "M. Dadu Films Digital Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.11.1"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"npm run dev -w @mdadu/web\" \"npm run start:dev -w @mdadu/api\"",
    "dev:web": "npm run dev -w @mdadu/web",
    "dev:api": "npm run start:dev -w @mdadu/api",
    "build": "npm run build -w @mdadu/web && npm run build -w @mdadu/api",
    "typecheck": "npm run typecheck -w @mdadu/web && npm run typecheck -w @mdadu/api",
    "test": "npm run test -w @mdadu/api",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify": "npm run check && npm run test:integration",
    "verify:local": "npm run db:up && npm run verify",
    "lint": "eslint apps --ext .ts,.tsx",
    "lint:fix": "eslint apps --ext .ts,.tsx --fix",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"*.json\" \"*.mjs\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"*.json\" \"*.mjs\"",
    "db:local": "docker compose -p mdadu-local -f docker-compose.local.yml up -d",
    "test:integration": "npm run build -w @mdadu/api && node scripts/integration-test.mjs",
    "db:seed:our-work": "node --env-file=apps/api/.env.dev scripts/seed-our-work.mjs",
    "db:indexes:dev": "node --env-file=apps/api/.env.dev -r ts-node/register apps/api/src/scripts/create-indexes.ts",
    "db:seed:dev": "node --env-file=apps/api/.env.dev scripts/seed-dev.mjs && npm run db:content:dev:apply && npm run db:indexes:dev",
    "db:reset:dev": "node --env-file=apps/api/.env.dev scripts/seed-dev.mjs --reset && npm run db:content:dev:apply && npm run db:indexes:dev",
    "env:check:dev": "node scripts/check-env-files.mjs dev all",
    "env:check:prod": "node scripts/check-env-files.mjs prod all",
    "start:prod": "concurrently -n WEB,API -c cyan,magenta \"npm run start -w @mdadu/web\" \"npm run start -w @mdadu/api\"",
    "db:indexes:prod": "node --env-file=apps/api/.env.prod -r ts-node/register apps/api/src/scripts/create-indexes.ts",
    "db:migrate:v2:dev": "node --env-file=apps/api/.env.dev scripts/migrate-backend-v2.mjs",
    "db:migrate:v2:dev:apply": "node --env-file=apps/api/.env.dev scripts/migrate-backend-v2.mjs --apply",
    "db:migrate:v2:prod": "node --env-file=apps/api/.env.prod scripts/migrate-backend-v2.mjs",
    "db:migrate:v2:prod:apply": "node --env-file=apps/api/.env.prod scripts/migrate-backend-v2.mjs --apply",
    "db:migrate:media:dev": "node --env-file=apps/api/.env.dev scripts/migrate-media-storage.mjs",
    "db:migrate:media:dev:apply": "node --env-file=apps/api/.env.dev scripts/migrate-media-storage.mjs --apply",
    "db:migrate:media:prod": "node --env-file=apps/api/.env.prod scripts/migrate-media-storage.mjs",
    "db:migrate:media:prod:apply": "node --env-file=apps/api/.env.prod scripts/migrate-media-storage.mjs --apply",
    "db:content:dev": "node --env-file=apps/api/.env.dev scripts/upsert-group11-content.mjs",
    "db:content:dev:apply": "node --env-file=apps/api/.env.dev scripts/upsert-group11-content.mjs --apply",
    "db:content:prod": "node --env-file=apps/api/.env.prod scripts/upsert-group11-content.mjs",
    "db:content:prod:apply": "node --env-file=apps/api/.env.prod scripts/upsert-group11-content.mjs --apply --confirm-production"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.70.0"
  }
}
